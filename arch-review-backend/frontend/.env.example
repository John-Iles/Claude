# No secrets belong in the frontend — all keys live in backend env vars.
#
# Local dev (default, no file needed):
# VITE_API_BASE=http://localhost:8000
#
# GitHub Codespaces — find your forwarded 8000 URL in the Ports tab, e.g.:
# VITE_API_BASE=https://upgraded-space-fishstick-abc123-8000.app.github.dev
VITE_API_BASE=http://localhost:8000
