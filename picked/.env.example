# Shopify CLI — for local development (shopify theme dev / shopify theme push)
# Never commit the actual values.
SHOPIFY_CLI_THEME_TOKEN=
SHOPIFY_STORE=picked.myshopify.com

# Klaviyo PUBLIC key — safe to expose client-side (read-only, identify-only).
# Also set this in: Shopify Admin > Themes > Customize > Theme settings > Klaviyo
# NEVER put the private Klaviyo API key anywhere in this project.
KLAVIYO_PUBLIC_KEY=       # 6-char public company ID, e.g. AbCdEf

# Analytics — optional, set in Theme settings to activate GA4
GA4_MEASUREMENT_ID=       # e.g. G-XXXXXXXXXX

# Domain
SITE_URL=https://picked.coffee
