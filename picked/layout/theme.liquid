<!doctype html>
<html lang="{{ request.locale.iso_code }}"{% if settings.ga4_measurement_id != blank %} data-ga4="{{ settings.ga4_measurement_id | escape }}"{% endif %}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/svg+xml" href="{{ 'logo.svg' | asset_url }}">

  {{ 'tokens.css' | asset_url | stylesheet_tag }}
  {{ 'base.css' | asset_url | stylesheet_tag }}

  {%- render 'seo-head' -%}
  {%- render 'klaviyo-init' -%}
  {%- render 'referral-logic' -%}

  {{ content_for_header }}
</head>
<body>

  <a class="visually-hidden" href="#main-content">{{ 'accessibility.skip_to_content' | t }}</a>

  {%- section 'header' -%}

  <main id="main-content" role="main">
    {{ content_for_layout }}
  </main>

  {%- section 'footer' -%}

  {%- render 'consent-banner' -%}
  {%- render 'icon-sprite' -%}

</body>
</html>
