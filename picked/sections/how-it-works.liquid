{{ 'section-how-it-works.css' | asset_url | stylesheet_tag }}

<section class="how-it-works section section--centered" id="how-it-works">
  <div class="container">

    {%- if section.settings.eyebrow != blank -%}
      <p class="section__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="section__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="section__subheading">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ol class="how-it-works__steps" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            <li class="how-it-works__step" {{ block.shopify_attributes }}>
              <span class="how-it-works__number" aria-hidden="true">{{ forloop.index }}</span>
              <h3 class="how-it-works__step-title">{{ block.settings.title | escape }}</h3>
              {%- if block.settings.body != blank -%}
                <p class="how-it-works__step-body">{{ block.settings.body | escape }}</p>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The model" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How Picked works" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Simple by design. Surprising by nature." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "body", "label": "Description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "We find the roaster",
            "body": "Each month we partner with one outstanding independent roaster — someone doing something genuinely interesting with their sourcing, their roasting, or their story."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "They ship direct",
            "body": "The featured roaster fulfils and ships their best seasonal offering directly to you. Fresh from the roastery, in letterbox-friendly packaging."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "You discover something new",
            "body": "A new coffee. A new roaster. A new story. Every month, curated — so you don't have to choose."
          }
        }
      ]
    }
  ]
}
{% endschema %}
